<?xml version="1.0" encoding="utf-8"?>
<!--
  Webhook, Pi-hole and Home Assistant actions often talk to devices on the home network over plain http
  (e.g. the Pi-hole on the NAS). Those are addresses the user typed in, so cleartext is allowed.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
